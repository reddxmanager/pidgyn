{
  "name": "app",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-29",
  "assets": {
    "directory": "public"
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_DIRECTORY",
        "class_name": "UserDirectory"
      },
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserDirectory", "ChatRoom"]
    }
  ]
}
